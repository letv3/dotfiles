grant-superadmin() {
  local instance
  instance=$(kubectl config current-context | cut -d/ -f1)
  cd ~/work/core/kube && uv run ./scripts/heimdall-run.py users ensure_superadmin oleksandr.lytvyn.admin@exponea.com "$instance"
}

grant-org-admin() {
  local org_id="$1"
  if [ -z "$org_id" ]; then
    echo "Usage: grant-org-admin <cloud_organisation_id>" >&2
    return 1
  fi
  cd ~/work/core/kube && uv run ./scripts/heimdall-run.py users ensure_org_admin oleksandr.lytvyn.admin@exponea.com "$org_id"
}
