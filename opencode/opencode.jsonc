{
  "plugin": [
    "oh-my-openagent@latest"
  ],
  "$schema": "https://opencode.ai/config.json",
  // Pins the primary session model (Sisyphus) to match oh-my-openagent.json agents.sisyphus.model.
  // Without this, opencode falls back to the "last used" model from the UI picker,
  // which overrides the per-agent model the plugin configured.
  // To override for a one-off session: opencode --model <provider>/<model>
  "model": "bloomreach-litellm/bedrock/kimi-k2.5",
  "provider": {
    "bloomreach-litellm": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Bloomreach LiteLLM",
      "options": {
        "baseURL": "https://api.tools.bloomreach.ai/v1",
        "apiKey": "{env:LITELLM_API_KEY}"
      },
      // Declaring all models used by oh-my-openagent.json so opencode can validate them.
      // Without this, any bloomreach-litellm model is rejected as "not valid" at session start.
      "models": {
        "bedrock/kimi-k2.5":        {},
        "vertex_ai/glm-5":          {},
        "openai/gpt-5.6-sol":       {},
        "openai/gpt-5.6-terra":     {},
        "openai/gpt-5.6-luna":      {},
        "openai/gpt-5.4-mini":      {},
        "openai/gpt-5.4-nano":      {},
        "openai/gpt-5-nano":        {},
        "bedrock/claude-sonnet-5":  {},
        "bedrock/claude-sonnet-4-6":{},
        "bedrock/claude-sonnet-4-5":{},
        "bedrock/claude-haiku-4-5": {}
      }
    }
  },
  "mcp": {
    "phoenix": {
      "type": "local",
      "command": ["sh", "-c", "npx -y @arizeai/phoenix-mcp@latest --baseUrl ${INSIDE_DEV_CONTAINER:+http://phoenix:6006}${INSIDE_DEV_CONTAINER:-http://localhost:6006}"],
      "enabled": true
    },
    "duckduckgo": {
      "type": "local",
      "command": ["uvx", "duckduckgo-mcp-server"],
      "enabled": true
    },
    "glean_default": {
      "type": "remote",
      "url": "https://bloomreach-be.glean.com/mcp/default",
      "enabled": true
    }
  }
}
